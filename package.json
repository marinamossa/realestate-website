{
	"name": "real-estate",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"compile:css": "sass scss/style.scss css/style.compiled.css --no-source-map",
		"prefix:css": "postcss css/style.compiled.css -o css/style.css",
		"build:css": "npm run compile:css && npm run prefix:css",
		"watch:sass": "sass --watch scss/style.scss:css/style.compiled.css --no-source-map",
		"watch:postcss": "postcss css/style.compiled.css -o css/style.css --watch",
		"watch:css": "concurrently \"npm:watch:sass\" \"npm:watch:postcss\""
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"browserslist": [
		"last 2 versions",
		"> 0.5%",
		"not dead"
	],
	"type": "commonjs",
	"devDependencies": {
		"autoprefixer": "^10.5.2",
		"concurrently": "^10.0.3",
		"postcss": "^8.5.16",
		"postcss-cli": "^11.0.1",
		"sass": "^1.101.0"
	}
}
